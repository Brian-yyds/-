{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "Perp Research 15m",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "timeframe": "15m",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "stake_currency": "USDT",
  "stake_amount": 500,
  "max_open_trades": 3,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "cancel_open_orders_on_exit": false,
  "strategy": "PerpBaseline15m",
  "fee": 0.0005,
  "unfilledtimeout": {"entry": 10, "exit": 10, "unit": "minutes"},
  "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {"enableRateLimit": true, "options": {"fetchMarkets": {"types": ["linear"]}}},
    "ccxt_async_config": {"enableRateLimit": true, "aiohttp_trust_env": true, "options": {"fetchMarkets": {"types": ["linear"]}}},
    "pair_whitelist": [
      "BTC/USDT:USDT", "ETH/USDT:USDT", "SOL/USDT:USDT", "BNB/USDT:USDT",
      "XRP/USDT:USDT", "DOGE/USDT:USDT", "LINK/USDT:USDT", "ADA/USDT:USDT",
      "AVAX/USDT:USDT", "SUI/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "telegram": {"enabled": false, "token": "", "chat_id": ""},
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "GENERATE_ON_FIRST_START",
    "ws_token": "GENERATE_ON_FIRST_START",
    "CORS_origins": [],
    "username": "research",
    "password": "GENERATE_ON_FIRST_START"
  },
  "internals": {"process_throttle_secs": 5}
}
